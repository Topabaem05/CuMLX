<!-- A cart on a rail with a pole on a hinge. The inertias come from these geoms, on every engine. Nothing collides. -->
<mujoco model="cumlx_cartpole">
  <option gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <body name="cart" pos="0 0 2">
      <joint name="slider" type="slide" axis="1 0 0" range="-4 4" limited="true"/>
      <geom name="cart_geom" type="box" size="0.2 0.1 0.1" mass="1" contype="0" conaffinity="0"/>
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom name="pole_geom" type="box" size="0.02 0.02 0.5" pos="0 0 0.5" mass="0.25" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
</mujoco>
